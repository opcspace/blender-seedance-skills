{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation_plan.schema.json",
  "title": "Precision Operation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "job_id", "steps"],
  "properties": {
    "spec_version": {"const": "2.0"},
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "tool",
          "asset_id",
          "params",
          "preconditions",
          "expected",
          "rollback",
          "depends_on"
        ],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "minLength": 1},
          "asset_id": {"type": "string", "minLength": 1},
          "params": {"type": "object"},
          "preconditions": {"type": "object"},
          "expected": {"type": "object"},
          "rollback": {"type": "object"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
